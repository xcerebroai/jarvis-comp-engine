# Jarvis Comp Engine — environment configuration
# Copy to .env.local and fill in as needed.

# --- Provider mode ---------------------------------------------------------
# true  → run entirely on the deterministic mock provider (no keys needed).
# false → use licensed providers below. If NONE are configured, the app
#         returns a clean error instead of silently using mock data.
JARVIS_USE_MOCK_PROVIDER=true

# --- Licensed data providers ----------------------------------------------
# Only licensed / ToS-compliant APIs. NEVER point these at a scraper of
# Zillow/Redfin/Realtor/Trulia/Opendoor/MLS. See docs/legal/DATA_SOURCING.md.
#
# ATTOM: subject property facts + AVM valuation.
ATTOM_API_KEY=
# MLS/RESO: comparable sales (sold + active listings).
MLS_API_KEY=
# Rent estimate provider (hold-strategy cash flow).
RENT_PROVIDER_API_KEY=
# County / public-records provider (assessor, recorder, tax).
COUNTY_PROVIDER_API_KEY=

# --- Optional provider base URLs (future) ---------------------------------
# A provider is "configured" once its API key is set, but no real call is made
# until its base URL is ALSO set. Endpoint/response mapping must be verified
# against each provider's official documentation before enabling. No scraping.
ATTOM_BASE_URL=
MLS_BASE_URL=
RENT_PROVIDER_BASE_URL=
COUNTY_PROVIDER_BASE_URL=
