# Jarvis Comp Engine — environment configuration
# Copy to .env.local and fill in. There is NO sample/mock mode in the server
# app: real providers or an honest error. (The GitHub Pages build is the only
# simulated-data surface, and it is loudly labeled.)

# --- Licensed data providers ----------------------------------------------
# Only licensed / ToS-compliant APIs. NEVER point these at a scraper of
# Zillow/Redfin/Realtor/Trulia/Opendoor/MLS. See docs/legal/DATA_SOURCING.md.
#
# DealMachine (https://api.docs.dealmachine.com): subject property facts,
# comparable sales, public records, and a supporting value estimate.
DEALMACHINE_API_KEY=

# Rent estimate provider (hold-strategy cash flow) — optional, future.
RENT_PROVIDER_API_KEY=
RENT_PROVIDER_BASE_URL=

# --- Claude API (parsing + memo prose only — never touches a number) ------
ANTHROPIC_API_KEY=

# --- Persistence -----------------------------------------------------------
# SQLite via Prisma. Local default; on Railway point at a mounted volume.
DATABASE_URL="file:./dev.db"
